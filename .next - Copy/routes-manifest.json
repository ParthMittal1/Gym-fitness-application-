{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/workouts/[id]",
      "regex": "^/workouts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/workouts/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/workouts/[id].segments/workouts/$d$id$segment",
          "source": "^/workouts/(?<nxtPid>[^/]+?)\\.segments/workouts/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/auth/register",
      "regex": "^/api/auth/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/register(?:/)?$"
    },
    {
      "page": "/api/exercises",
      "regex": "^/api/exercises(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/exercises(?:/)?$"
    },
    {
      "page": "/api/goals",
      "regex": "^/api/goals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/goals(?:/)?$"
    },
    {
      "page": "/api/payments/create-order",
      "regex": "^/api/payments/create\\-order(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/payments/create\\-order(?:/)?$"
    },
    {
      "page": "/api/payments/verify",
      "regex": "^/api/payments/verify(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/payments/verify(?:/)?$"
    },
    {
      "page": "/api/progress",
      "regex": "^/api/progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/progress(?:/)?$"
    },
    {
      "page": "/api/workout-log",
      "regex": "^/api/workout\\-log(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/workout\\-log(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/goals",
      "regex": "^/dashboard/goals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/goals(?:/)?$"
    },
    {
      "page": "/dashboard/log",
      "regex": "^/dashboard/log(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/log(?:/)?$"
    },
    {
      "page": "/dashboard/membership",
      "regex": "^/dashboard/membership(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/membership(?:/)?$"
    },
    {
      "page": "/dashboard/progress",
      "regex": "^/dashboard/progress(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/progress(?:/)?$"
    },
    {
      "page": "/dashboard/workouts",
      "regex": "^/dashboard/workouts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/workouts(?:/)?$"
    },
    {
      "page": "/exercises",
      "regex": "^/exercises(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/exercises(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/locations",
      "regex": "^/locations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/locations(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/tips",
      "regex": "^/tips(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tips(?:/)?$"
    },
    {
      "page": "/workouts",
      "regex": "^/workouts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workouts(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}